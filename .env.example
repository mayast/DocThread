# Hosted GitHub device flow. The OAuth app must have Device Flow enabled.
# Public client ID; no client secret is used.
VITE_GH_CLIENT_ID=

# Azure Static Web Apps uses its managed /api device-code/token relays.
VITE_OAUTH_PROXY=/api

# DocThread single-tenant Entra SPA. These identifiers are public configuration.
VITE_AZURE_CLIENT_ID=3a9dd418-f26a-4e43-b3bb-30a5c89b251a
VITE_AZURE_TENANT_ID=72f988bf-86f1-41af-91ab-2d7cd011db47

# Microsoft Graph people search. Values: off | msal
VITE_GRAPH_TRANSPORT=msal

# Azure DevOps source transport. Secure hosted builds require off.
# For explicit local Azure CLI development only, use dev-cli in .env.local.
# A future direct-msal mode requires separately consented Azure DevOps delegated access.
VITE_ADO_TRANSPORT=off

# @mention email relay (server-side only; never bundled into the client):
# NOTIFY_WEBHOOK_URL   — the Azure Logic App "When a HTTP request is received" URL
#                        that sends the Outlook email. Set as an app setting / .env.local.
# NOTIFY_ALLOWED_DOMAINS — comma-separated recipient domain allowlist enforced by the
#                        /api/notify relay so it can never email arbitrary external
#                        addresses. Defaults to microsoft.com when unset.
# NOTIFY_WEBHOOK_URL=
# NOTIFY_ALLOWED_DOMAINS=microsoft.com
# Optional Microsoft Teams delivery for review notifications (#31). Opt-in and off
# by default. Two independent settings:
#   VITE_TEAMS_NOTIFY=on   — client flag: also send a Teams card when a mention is
#                            emailed (build-time; safe to leave off).
#   TEAMS_WEBHOOK_URL      — server-side Teams Incoming Webhook / Workflow URL the
#                            /api/notify relay posts the card to. The SAME
#                            NOTIFY_ALLOWED_DOMAINS allowlist is enforced, so Teams
#                            is never an open relay. Delivery no-ops when unset.
# VITE_TEAMS_NOTIFY=off
# TEAMS_WEBHOOK_URL=
# Optional AI summarization endpoint for the "Summarize review" action. Unset by
# default — the feature then generates a deterministic local digest. When set, the
# client POSTs a read-only { docTitle, scope, threads } payload and expects
# { summary: string } back. Any failure falls back to the local digest.
# VITE_SUMMARIZE_ENDPOINT=
# Optional AI endpoint for "AI: draft a fix" (#63) — turns review feedback on an
# anchored span into an apply-ready replacement (reuses the #35 suggestion UI).
# Unset by default; the action then shows a clear note (no crash, no repo write).
# When set, the client POSTs a read-only { original, feedback, docTitle, skill? } payload
# and expects { replacement: string } back.
# VITE_SUGGEST_ENDPOINT=
# Optional AI endpoint for the "Assess readiness" action (#44) — grades the current
# document against an AI Implementation Readiness Standard. Unset by default; the
# action then uses a deterministic local rubric. When set, the client POSTs a
# read-only { docTitle, markdown, skill? } payload and expects
# { score: number, grade?: string, gaps?: [{ title, detail, severity, quote?, replacement? }] } back.
# Any failure falls back to the local rubric.
# VITE_READINESS_ENDPOINT=
# Optional AI endpoint for the "Run AI review" pass (#43), governed by an optional
# REVIEW.md policy (#89). Unset by default; the reviewer then runs a deterministic
# local pass (still live). When set, the client POSTs a read-only
# { docTitle, markdown, policy, skill? } payload and expects
# { findings: [{ title, rationale, quote, intent, severity, pass, replacement? }] } back.
# Any failure falls back to the local pass. A repo-root REVIEW.md, when present on a
# GitHub source, governs the passes / Important-vs-Nit split / nit cap / exclusions.
# VITE_REVIEW_ENDPOINT=
# Optional comma/newline-separated repo paths or URLs to skill files (#92). Any
# Markdown/text filename is accepted; the first readable skill is applied to AI
# review, readiness, and suggested-edit calls unless the reviewer selects/uploads/
# pastes another skill in the review UI.
# VITE_SKILL_PATHS=.docthread/skills/prd/SKILL.md,docs/brand-voice.md
